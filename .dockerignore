# Dependency (akan diinstall ulang di dalam container/entrypoint)
vendor/
node_modules/

# Git
.git/
.gitignore
.gitattributes

# Environment & secret - jangan pernah ikut ke dalam image
.env
.env.backup
.env.production

# Storage generated (dibuat ulang otomatis saat runtime)
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore

# Build artifact lama (akan dibangun ulang oleh entrypoint)
public/build/
public/hot

# Tooling & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
.phpunit.result.cache
tests/

# File database lama (SQLite) yang tidak dipakai lagi
labmoneylens_db

README.md
